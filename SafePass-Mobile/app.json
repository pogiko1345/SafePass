{
  "expo": {
    "name": "Sapphire International Aviation Academy",
    "slug": "safepass-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/LogoSapphireAppIcon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/LogoSapphireAppIcon.png",
      "resizeMode": "contain",
      "backgroundColor": "#052044"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "This app uses the camera to take photos of your ID for verification",
        "NSPhotoLibraryUsageDescription": "This app needs access to your photo library to upload your ID",
        "NSLocationWhenInUseUsageDescription": "SafePass uses your location while you are checked in so security can monitor active visitor presence."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/LogoSapphireAppIcon.png",
        "backgroundColor": "#052044"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.NFC",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon-school.png",
      "build": {
        "output": "static"
      }
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      "expo-sharing",
      "react-native-nfc-manager",
      [
        "expo-image-picker",
        {
          "photosPermission": "The app needs access to your photos to upload your ID.",
          "cameraPermission": "The app needs access to your camera to take photos of your ID."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SafePass uses your location while you are checked in so security can monitor active visitor presence."
        }
      ]
    ],
    "extra": {
      "appVariant": "full",
      "appDisplayName": "Sapphire International Aviation Academy",
      "appOrganization": "Sapphire International Aviation Academy",
      "facebookAppId": "1599774541871796",
      "googleClientId": "YOUR_GOOGLE_CLIENT_ID",
      "eas": {
        "projectId": "b7043c15-cb4c-4f94-a9bc-3af130c25647"
      }
    }
  }
}
